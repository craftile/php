parameters:
    level: 5
    paths:
        - packages/core/src
        - packages/laravel/src

    bootstrapFiles:
        - vendor/autoload.php

    excludePaths:
        - packages/*/tests/*
        - packages/*/vendor/*

    tmpDir: .phpstan
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Concerns are public API applied by packages that consume Craftile,
        # so they are never used inside the analysed source paths.
        - identifier: trait.unused
